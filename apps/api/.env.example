# Copy to apps/api/.env for local dev. In production set these in the Render dashboard.

NODE_ENV=development
PORT=8000
# Where the web app runs (CORS + cookie origin). Prod: https://<project>.vercel.app
WEB_ORIGIN=http://localhost:5173

# Neon → Project → Connection Details → pooled connection string (use a "dev" branch locally)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/clinic?sslmode=require
# …or the local Docker Postgres from docker-compose.yml:
# DATABASE_URL=postgresql://clinic:clinic@localhost:5433/clinic

# Password given to the demo logins by `npm run db:seed` (local/dev only)
SEED_PASSWORD=ClinicDemo2026!

# Random 32+ chars: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Google sign-in for patients (free). Google Cloud Console → APIs & Services →
# Credentials → Create OAuth client ID → Web application.
#   Authorized redirect URI: <WEB_ORIGIN>/api/auth/google/callback
#   e.g. http://localhost:5173/api/auth/google/callback and https://<app>.vercel.app/api/auth/google/callback
# Leave blank to hide the "Continue with Google" button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo → SMTP & API → API Keys. Sender must be verified in Brevo → Senders.
# Leave the key blank locally to log emails instead of sending.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Clinic Appointments

# Shared secret the scheduler sends to POST /api/cron/reminders (see .github/workflows/reminders.yml)
CRON_SECRET=

# Initial clinic time zone (admin can change it later in the app)
DEFAULT_CLINIC_TIMEZONE=Asia/Manila

# Booking rules (defaults shown)
BOOKING_GRACE_MINUTES=15
MAX_BOOKING_DAYS_AHEAD=365

# One-time first-admin page (/setup) on a fresh deployment. Render generates this.
SETUP_TOKEN=
