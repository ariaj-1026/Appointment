# Copy to apps/web/.env for local dev. Vite only exposes VITE_* vars to the browser —
# never put secrets here.

# Dev proxy target for /api (Vite dev server only). Prod uses the rewrite in vercel.json.
VITE_API_TARGET=http://127.0.0.1:8000

# Shown in the UI header / emails
VITE_CLINIC_NAME=Clinic Appointments
